# Atlas service account used by the official MongoDB MCP server.
# Create one in Atlas: Organization → Project Identity and Access → Applications.
# Add this machine's IP to the service account API access list.
MDB_MCP_API_CLIENT_ID=
MDB_MCP_API_CLIENT_SECRET=

# Optional. Set only if you connect with a database user instead of the service account.
# MDB_MCP_CONNECTION_STRING=

# Passed through to the MCP server when you want read-only database tools.
# MDB_MCP_READ_ONLY=true

# Official remote MCP launcher. Leave as-is for the summit demo.
MDB_MCP_COMMAND=npx
MDB_MCP_ARGS=-y mongodb-atlas-mcp-remote@latest

# Amazon Bedrock model used by the Strands agent. ap-south-1 is Mumbai.
AWS_REGION=ap-south-1
MODEL_ID=in.anthropic.claude-opus-5
# Fallback if the inference profile above is not enabled:
# MODEL_ID=apac.amazon.nova-pro-v1:0

PORT=8080
